[Unit]
Description=Mission Control Dashboard
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/mission-control-dashboard
ExecStart=/usr/bin/python3 %h/.local/share/mission-control-dashboard/dashboard_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
